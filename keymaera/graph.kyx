Theorem "ReservoirSafety"
  ProgramVariables.
    Real node;
    Real weight;
  End.

  Problem
    (
      node = 0 & weight = 0
    )
    ->
    [
      (
        (
          ?node = 0;
          (
            node := 1; weight := weight + 0.1
            ++
            node := 2; weight := weight + 0.17
            )
          )
        ++
      (
          ?node = 1;
          (
            node := 0; weight := weight + 0.1
            ++
            node := 2; weight := weight + 0.02
            )
          )
        ++
      (
          ?node = 2;
          (
            node := 0; weight := weight + 0.17
            ++
            node := 1; weight := weight + 0.02
            )
          )
      )*
    ]
  (weight >= 0)
  End.
End.
